---
import BaseLayout from "../layouts/BaseLayout.astro";
import SearchBox from "../components/SearchBox.astro";
---

<BaseLayout title="Buscar" noindex>
  <section class="shell search-page">
    <h1 class="serif search__title">Buscar</h1>
    <p class="search__description">
      Busca entre los artículos publicados por título, descripción o etiqueta.
    </p>
    <SearchBox />
  </section>
</BaseLayout>

<style>
  .shell.search-page {
    padding-top: 2rem;
    padding-bottom: 2.5rem;
  }
  .search__title {
    font-size: clamp(1.875rem, 1.25rem + 2vw, 2.75rem);
    font-weight: 500;
  }
  .search__description {
    color: var(--ink-secondary);
    margin: 0.5rem 0 2rem;
    max-width: var(--content-measure);
  }
  @media (min-width: 768px) {
    .shell.search-page {
      padding-top: 4rem;
      padding-bottom: 4rem;
    }
  }
</style>
