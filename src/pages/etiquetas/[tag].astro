---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostGrid from "../../components/PostGrid.astro";
import { getAllTags, getPublishedPosts, tagSlug } from "../../lib/posts";
import type { BlogPost } from "../../lib/posts";
import { withBase } from "../../lib/url";

export async function getStaticPaths() {
  const tags = await getAllTags();
  const posts = await getPublishedPosts();
  return tags.map((item) => ({
    params: { tag: item.slug },
    props: {
      tag: item.tag,
      slug: item.slug,
      count: item.count,
      posts: posts.filter((post) =>
        post.data.tags.some((t) => tagSlug(t) === item.slug),
      ),
    },
  }));
}

interface Props {
  tag: string;
  slug: string;
  count: number;
  posts: BlogPost[];
}

const { tag, count, posts } = Astro.props;
---

<BaseLayout title={`Etiqueta: ${tag}`}>
  <section class="shell tag">
    <p class="mono tag__kicker">Etiqueta</p>
    <h1 class="serif tag__title">{tag}</h1>
    <p class="tag__count">
      {count} artículo{count === 1 ? "" : "s"}
    </p>
    {posts.length === 0 ? (
      <p class="tag__empty">No hay artículos para esta etiqueta.</p>
    ) : (
      <PostGrid posts={posts} />
    )}
    <p class="tag__back">
      <a href={withBase("/etiquetas/")}>Ver todas las etiquetas</a>
    </p>
  </section>
</BaseLayout>

<style>
  .tag {
    padding-top: 4rem;
    padding-bottom: 4rem;
  }
  .tag__kicker {
    color: var(--ink-secondary);
    font-size: 0.8rem;
    letter-spacing: 0.05em;
    margin: 0 0 0.5rem;
  }
  .tag__title {
    font-size: clamp(1.875rem, 1.25rem + 2vw, 2.75rem);
    font-weight: 500;
  }
  .tag__count {
    color: var(--ink-secondary);
    margin: 0.5rem 0 2rem;
  }
  .tag__empty {
    color: var(--ink-secondary);
  }
  .tag__back {
    margin-top: 3rem;
  }
  .tag__back a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--ink-secondary);
    text-decoration: none;
  }
  .tag__back a:hover {
    color: var(--accent-terracotta);
  }
  @media (max-width: 640px) {
    .tag {
      padding-top: var(--space-8);
      padding-bottom: var(--space-12);
    }
    .tag__count {
      margin-bottom: var(--space-6);
    }
    .tag__back {
      margin-top: var(--space-8);
    }
  }
</style>
