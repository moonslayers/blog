---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllTags } from "../../lib/posts";
import { withBase } from "../../lib/url";

const tags = await getAllTags();
---

<BaseLayout title="Etiquetas">
  <section class="shell tags-index">
    <h1 class="serif tags-index__title">Etiquetas</h1>
    <p class="tags-index__subtitle">
      Todos los temas que aparecen en los artículos publicados.
    </p>
    {tags.length === 0 ? (
      <p style="color: var(--ink-secondary);">Todavía no hay etiquetas.</p>
    ) : (
      <ul class="tag-list">
        {tags.map((item) => (
          <li>
            <a href={withBase(`/etiquetas/${item.slug}/`)} class="tag-chip">
              {item.tag} <span class="tag-chip__count">{item.count}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .tags-index {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
  }
  .tags-index__title {
    font-size: clamp(1.875rem, 1.25rem + 2vw, 2.75rem);
    font-weight: 500;
  }
  .tags-index__subtitle {
    color: var(--ink-secondary);
    margin: 0.5rem 0 2rem;
  }
  .tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 640px) {
    .tags-index {
      padding-top: var(--space-8);
      padding-bottom: var(--space-12);
    }
    .tags-index__subtitle {
      margin-bottom: var(--space-6);
    }
  }
</style>
