---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAllTags } from "../../lib/posts";
import { withBase } from "../../lib/url";

const tags = await getAllTags();
---

<BaseLayout title="Etiquetas">
  <section class="shell" style="padding-top: 4rem; padding-bottom: 4rem;">
    <h1
      class="serif"
      style="font-size: clamp(1.875rem, 1.25rem + 2vw, 2.75rem); font-weight: 500;"
    >
      Etiquetas
    </h1>
    <p style="color: var(--ink-secondary); margin: 0.5rem 0 2rem;">
      Todos los temas que aparecen en los artículos publicados.
    </p>
    {tags.length === 0 ? (
      <p style="color: var(--ink-secondary);">Todavía no hay etiquetas.</p>
    ) : (
      <ul class="tag-list">
        {tags.map((item) => (
          <li>
            <a href={withBase(`/etiquetas/${item.slug}/`)} class="tag-chip">
              {item.tag} <span class="tag-chip__count">{item.count}</span>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</BaseLayout>

<style>
  .tag-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    padding: 0.35rem 0.7rem;
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    color: var(--ink-secondary);
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }
  .tag-chip:hover {
    color: var(--accent-terracotta);
    border-color: var(--accent-terracotta);
  }
  .tag-chip__count {
    font-size: 0.7rem;
    color: var(--ink-secondary);
  }
</style>
