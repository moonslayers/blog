---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts } from "../../lib/posts";
import { withBase } from "../../lib/url";
import type { BlogPost } from "../../lib/posts";

export const getStaticPaths: import("astro").GetStaticPaths = async ({
  paginate,
}) => {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: 10 });
};

interface Props {
  page: {
    data: BlogPost[];
    currentPage: number;
    lastPage: number;
    url: { prev?: string; next?: string };
  };
}

const { page } = Astro.props;
---

<BaseLayout
  title={
    page.currentPage > 1
      ? `Artículos — Página ${page.currentPage}`
      : "Artículos"
  }
>
  <section class="shell" style="padding-top: 4rem; padding-bottom: 4rem;">
    <p style="margin-bottom: 2rem;">
      <a
        href={withBase("/")}
        class="mono"
        style="font-size: 0.8rem; color: var(--ink-secondary); text-decoration: none;"
      >
        ← Volver a la home
      </a>
    </p>
    <h1
      class="serif"
      style="font-size: clamp(1.875rem, 1.25rem + 2vw, 2.75rem); font-weight: 500;"
    >
      Artículos
    </h1>
    <p style="color: var(--ink-secondary); margin: 0.5rem 0 2rem;">
      Todos los artículos publicados, del más reciente al más antiguo.
    </p>
    {page.data.length === 0 ? (
      <p style="color: var(--ink-secondary);">
        Todavía no hay artículos publicados.
      </p>
    ) : (
      <div style="display: flex; flex-direction: column; gap: 3rem; max-width: 720px;">
        {page.data.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}
    <nav
      aria-label="Paginación"
      style="margin-top: 3rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;"
    >
      <div>
        {page.url.prev && (
          <a href={page.url.prev} rel="prev" aria-label="Página anterior">
            ← Anterior
          </a>
        )}
      </div>
      <p
        class="mono"
        style="font-size: 0.85rem; color: var(--ink-secondary); margin: 0;"
      >
        Página {page.currentPage} de {page.lastPage}
      </p>
      <div>
        {page.url.next && (
          <a href={page.url.next} rel="next" aria-label="Página siguiente">
            Siguiente →
          </a>
        )}
      </div>
    </nav>
  </section>
</BaseLayout>
