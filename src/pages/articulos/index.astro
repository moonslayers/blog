---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPublishedPosts } from "../../lib/posts";
import { withBase } from "../../lib/url";

const posts = await getPublishedPosts();
---

<BaseLayout title="Artículos">
  <section class="shell" style="padding-top: 4rem; padding-bottom: 4rem;">
    <p style="margin-bottom: 2rem;">
      <a
        href={withBase("/")}
        class="mono"
        style="font-size: 0.8rem; color: var(--ink-secondary); text-decoration: none;"
      >
        ← Volver a la home
      </a>
    </p>
    <h1
      class="serif"
      style="font-size: clamp(1.875rem, 1.25rem + 2vw, 2.75rem); font-weight: 500;"
    >
      Artículos
    </h1>
    <p style="color: var(--ink-secondary); margin: 0.5rem 0 2rem;">
      Todos los artículos publicados, del más reciente al más antiguo.
    </p>
    {posts.length === 0 ? (
      <p style="color: var(--ink-secondary);">
        Todavía no hay artículos publicados.
      </p>
    ) : (
      <div style="display: flex; flex-direction: column; gap: 3rem; max-width: 720px;">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    )}
  </section>
</BaseLayout>
