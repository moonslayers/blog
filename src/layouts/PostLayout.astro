---
import BaseLayout from "./BaseLayout.astro";
import { SITE_TITLE } from "../consts";
import { withBase, absoluteUrl } from "../lib/url";
import { readingTime, tagSlug, coverFor, postPath } from "../lib/posts";
import type { BlogPost } from "../lib/posts";
import PostMeta from "../components/PostMeta.astro";
import ShareLinks from "../components/ShareLinks.astro";

interface Props {
  post: BlogPost;
  previous?: BlogPost | null;
  next?: BlogPost | null;
}

const { post, previous = null, next = null } = Astro.props;
const cover = coverFor(post);
const canonical = absoluteUrl(`/articulos/${post.id}/`);
const rt = readingTime(post.body);
const tags = post.data.tags;
const author = post.data.author ?? "Jorge Marquez";
const ogImageAlt = post.data.coverAlt ?? post.data.title;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { "@type": "Person", name: author },
  image: cover.absolute,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  publisher: { "@type": "Organization", name: "Espacio Latente" },
  url: canonical,
};
const jsonLdStr = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<BaseLayout
  title={`${post.data.title} — ${SITE_TITLE}`}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
  ogImage={cover.absolute}
  twitterCard="summary_large_image"
>
  <Fragment slot="head">
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta
      property="article:published_time"
      content={post.data.date.toISOString()}
    />
    {post.data.updated && (
      <meta
        property="article:modified_time"
        content={post.data.updated.toISOString()}
      />
    )}
    <meta property="article:author" content={author} />
    {tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <script type="application/ld+json" set:html={jsonLdStr} />
  </Fragment>

  <article>
    <div class="shell" style="padding-top: 2rem; padding-bottom: 1rem;">
      <a
        href={withBase("/articulos/")}
        class="mono"
        style="font-size: 0.8rem; color: var(--ink-secondary); text-decoration: none;"
      >
        ← Volver a artículos
      </a>
    </div>

    <header class="shell" style="padding-bottom: 1.5rem;">
      <h1
        class="serif"
        style="font-size: clamp(1.875rem, 1.25rem + 2vw, 2.75rem); font-weight: 500; letter-spacing: -0.015em; line-height: 1.1; max-width: var(--content-measure);"
      >
        {post.data.title}
      </h1>
      <p style="margin-top: 0.75rem; color: var(--ink-secondary); max-width: var(--content-measure);">
        {post.data.description}
      </p>
      <div style="margin-top: 1rem;">
        <PostMeta date={post.data.date} readingTime={rt} author={author} />
      </div>
      {tags.length > 0 && (
        <ul style="list-style: none; padding: 0; margin: 1rem 0 0; display: flex; gap: 0.5rem; flex-wrap: wrap;">
          {tags.map((tag) => (
            <li>
              <a
                href={withBase(`/etiquetas/${tagSlug(tag)}/`)}
                class="mono"
                style="font-size: 0.75rem; border: 1px solid var(--ink-light); border-radius: 4px; padding: 2px 8px; text-decoration: none; color: var(--ink-secondary);"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}
    </header>

    <div class="shell" style="padding-bottom: 2rem;">
      <img
        src={cover.src}
        alt={post.data.coverAlt ?? post.data.title}
        width="1200"
        height="630"
        loading="eager"
        fetchpriority="high"
        style="width: 100%; max-width: var(--content-measure); height: auto; border-radius: 8px;"
      />
    </div>

    <div class="shell">
      <div class="prose">
        <slot />
      </div>
    </div>

    <div class="shell" style="padding-top: 2rem;">
      <ShareLinks url={canonical} title={post.data.title} />
    </div>

    <nav
      class="shell"
      aria-label="Navegación entre artículos"
      style="padding-top: 2rem; padding-bottom: 3rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;"
    >
      <div>
        {previous && (
          <a
            href={postPath(previous.id)}
            aria-label={`Anterior: ${previous.data.title}`}
          >
            ← {previous.data.title}
          </a>
        )}
      </div>
      <div>
        {next && (
          <a
            href={postPath(next.id)}
            aria-label={`Siguiente: ${next.data.title}`}
          >
            {next.data.title} →
          </a>
        )}
      </div>
    </nav>
  </article>
</BaseLayout>
