---
import BaseLayout from "./BaseLayout.astro";
import { withBase, absoluteUrl } from "../lib/url";
import { readingTime, tagSlug, coverFor, postPath } from "../lib/posts";
import type { BlogPost } from "../lib/posts";
import PostMeta from "../components/PostMeta.astro";
import ShareLinks from "../components/ShareLinks.astro";

interface Props {
  post: BlogPost;
  previous?: BlogPost | null;
  next?: BlogPost | null;
}

const { post, previous = null, next = null } = Astro.props;
const cover = coverFor(post);
const canonical = absoluteUrl(`/articulos/${post.id}/`);
const rt = readingTime(post.body);
const tags = post.data.tags;
const author = post.data.author ?? "Jorge Marquez";
const ogImageAlt = post.data.coverAlt ?? post.data.title;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  dateModified: (post.data.updated ?? post.data.date).toISOString(),
  author: { "@type": "Person", name: author },
  image: cover.absolute,
  mainEntityOfPage: { "@type": "WebPage", "@id": canonical },
  publisher: { "@type": "Organization", name: "Espacio Latente" },
  url: canonical,
};
const jsonLdStr = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  canonical={canonical}
  ogType="article"
  ogImage={cover.absolute}
  twitterCard="summary_large_image"
>
  <Fragment slot="head">
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta
      property="article:published_time"
      content={post.data.date.toISOString()}
    />
    {post.data.updated && (
      <meta
        property="article:modified_time"
        content={post.data.updated.toISOString()}
      />
    )}
    <meta property="article:author" content={author} />
    {tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    ))}
    <script type="application/ld+json" set:html={jsonLdStr} />
  </Fragment>

  <article class="post">
    <div class="shell post-back-wrap">
      <a href={withBase("/articulos/")} class="mono post-back">
        ← Volver a artículos
      </a>
    </div>

    <header class="shell post-header">
      <div class="post-header__inner">
        <h1 class="serif post-title">{post.data.title}</h1>
        <p class="post-deck">{post.data.description}</p>
        <div class="post-meta-wrap">
          <PostMeta date={post.data.date} readingTime={rt} author={author} />
        </div>
        {tags.length > 0 && (
          <ul class="post-tags">
            {tags.map((tag) => (
              <li>
                <a
                  href={withBase(`/etiquetas/${tagSlug(tag)}/`)}
                  class="tag-chip"
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <div class="shell post-cover-wrap">
      <img
        src={cover.src}
        alt={post.data.coverAlt ?? post.data.title}
        width="1200"
        height="630"
        loading="eager"
        fetchpriority="high"
        class="post-cover"
      />
    </div>

    <div class="shell post-prose-wrap">
      <div class="prose post-prose">
        <slot />
      </div>
    </div>

    <div class="shell post-share-wrap">
      <div class="post-share-inner">
        <ShareLinks url={canonical} title={post.data.title} />
      </div>
    </div>

    <nav class="shell post-pager" aria-label="Navegación entre artículos">
      {previous && (
        <div class="post-pager__item">
          <a
            href={postPath(previous.id)}
            aria-label={`Anterior: ${previous.data.title}`}
            class="post-pager__link post-pager__link--prev"
          >
            <span aria-hidden="true" class="post-pager__arrow">
              ←
            </span>
            <span class="post-pager__title">{previous.data.title}</span>
          </a>
        </div>
      )}
      {next && (
        <div class="post-pager__item post-pager__item--next">
          <a
            href={postPath(next.id)}
            aria-label={`Siguiente: ${next.data.title}`}
            class="post-pager__link post-pager__link--next"
          >
            <span class="post-pager__title">{next.data.title}</span>
            <span aria-hidden="true" class="post-pager__arrow">
              →
            </span>
          </a>
        </div>
      )}
    </nav>
  </article>
</BaseLayout>

<style>
  .post {
    min-width: 0;
  }
  .post-back-wrap {
    padding-top: 2rem;
    padding-bottom: 1rem;
  }
  .post-back {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.25rem 0.5rem;
    margin-left: -0.5rem;
    font-size: 0.8rem;
    color: var(--ink-secondary);
    text-decoration: none;
    border-radius: var(--radius-sm);
  }
  .post-back:hover {
    color: var(--accent-terracotta);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .post-back:focus-visible {
    outline: 2px solid var(--accent-terracotta);
    outline-offset: 2px;
  }
  .post-header {
    padding-bottom: 1.5rem;
  }
  .post-header__inner {
    max-width: var(--content-measure);
    margin: 0 auto;
    min-width: 0;
  }
  .post-title {
    margin: 0;
    font-size: clamp(1.875rem, 1.25rem + 2vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.1;
    overflow-wrap: break-word;
    text-wrap: balance;
  }
  .post-deck {
    margin: 0.75rem 0 0;
    color: var(--ink-secondary);
    line-height: 1.65;
    overflow-wrap: break-word;
  }
  .post-meta-wrap {
    margin-top: 1rem;
    min-width: 0;
  }
  .post-meta-wrap :global(.post-meta) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    min-width: 0;
  }
  .post-tags {
    list-style: none;
    padding: 0;
    margin: 1rem 0 0;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .post-cover-wrap {
    padding-bottom: 2rem;
  }
  .post-cover {
    display: block;
    width: 100%;
    max-width: var(--content-measure);
    height: auto;
    margin: 0 auto;
    border-radius: 8px;
  }
  .post-prose-wrap {
    min-width: 0;
  }
  .post-prose {
    min-width: 0;
    overflow-wrap: break-word;
  }
  .post-prose a {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .post-prose code {
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .post-prose pre {
    max-width: 100%;
    overflow-x: auto;
  }
  .post-prose img,
  .post-prose video,
  .post-prose iframe {
    max-width: 100%;
  }
  .post-prose table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
  }
  .post-share-wrap {
    padding-top: 2rem;
    min-width: 0;
  }
  .post-share-inner {
    max-width: var(--content-measure);
    margin: 0 auto;
    min-width: 0;
  }
  .post-pager {
    padding-top: 2rem;
    padding-bottom: 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .post-pager__item {
    flex: 1 1 16rem;
    min-width: 0;
    display: flex;
  }
  .post-pager__item--next {
    justify-content: flex-end;
  }
  .post-pager__link {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.75rem 1rem;
    border: var(--border-thin);
    border-radius: var(--radius-md);
    color: var(--ink-primary);
    text-decoration: none;
    transition:
      border-color 120ms ease-in-out,
      color 120ms ease-in-out;
  }
  .post-pager__link:hover {
    border-color: var(--accent-terracotta);
  }
  .post-pager__link:focus-visible {
    outline: 2px solid var(--accent-terracotta);
    outline-offset: 2px;
  }
  .post-pager__link--next {
    justify-content: flex-end;
    text-align: right;
  }
  .post-pager__arrow {
    flex-shrink: 0;
    color: var(--ink-secondary);
  }
  .post-pager__link:hover .post-pager__arrow {
    color: var(--accent-terracotta);
  }
  .post-pager__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    overflow-wrap: anywhere;
    font-size: 0.95rem;
    line-height: 1.4;
  }
  @media (max-width: 640px) {
    .post-back-wrap {
      padding-top: 1.25rem;
      padding-bottom: 0.75rem;
    }
    .post-header {
      padding-bottom: 1.25rem;
    }
    .post-cover-wrap {
      padding-bottom: 1.5rem;
    }
    .post-pager {
      flex-direction: column;
      align-items: stretch;
    }
    .post-pager__item {
      flex: 1 1 auto;
    }
    .post-pager__link--next {
      justify-content: flex-start;
      text-align: left;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .post-back,
    .post-pager__link {
      transition-duration: 0ms;
    }
  }
</style>
