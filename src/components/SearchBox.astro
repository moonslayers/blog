---
import { withBase } from "../lib/url";

interface Props {
  id?: string;
}

const { id = "search" } = Astro.props;
const inputId = `${id}-input`;
const statusId = `${id}-status`;
const resultsId = `${id}-results`;
---

<div
  class="search-box"
  data-search-box
  data-index-url={withBase("/buscar-index.json")}
>
  <label for={inputId} class="search-box__label">
    Buscar artículos
  </label>
  <div class="search-box__field">
    <input
      id={inputId}
      type="search"
      class="search-box__input"
      placeholder="Escribe una o varias palabras"
      autocomplete="off"
      spellcheck="false"
      enterkeyhint="search"
    />
    <button
      type="button"
      class="search-box__clear"
      aria-label="Limpiar búsqueda"
      hidden
    >
      ×
    </button>
  </div>
  <p class="search-box__help">
    La búsqueda es local: se comparan título, descripción y etiquetas. Todos los
    términos deben coincidir.
  </p>
  <p
    id={statusId}
    class="search-box__status mono"
    aria-live="polite"
    role="status"
  >
    Escribe para buscar artículos.
  </p>
  <ul id={resultsId} class="search-box__results" role="list"></ul>
</div>

<script>
  import type { SearchEntry } from "../lib/posts";
  import { normalizeText } from "../lib/text";

  type Entry = SearchEntry;

  const roots = document.querySelectorAll<HTMLElement>("[data-search-box]");
  for (const root of roots) {
    const indexUrl = root.dataset.indexUrl ?? "";
    const input = root.querySelector<HTMLInputElement>("input[type='search']");
    const clear = root.querySelector<HTMLButtonElement>(".search-box__clear");
    const status = root.querySelector<HTMLElement>("[aria-live='polite']");
    const results = root.querySelector<HTMLUListElement>("ul[role='list']");

    let entries: Entry[] = [];

    fetch(indexUrl)
      .then((response) => response.json())
      .then((data: Entry[]) => {
        entries = Array.isArray(data) ? data : [];
      })
      .catch(() => {
        if (status)
          status.textContent = "No se pudo cargar el índice de búsqueda.";
      });

    function render(matches: Entry[], query: string) {
      if (!results || !status) return;
      results.innerHTML = "";
      if (query === "") {
        status.textContent = "Escribe para buscar artículos.";
        return;
      }
      if (matches.length === 0) {
        status.textContent = `Sin resultados para «${query}».`;
        return;
      }
      status.textContent = `${matches.length} resultado${matches.length === 1 ? "" : "s"}.`;
      for (const entry of matches) {
        const li = document.createElement("li");
        const a = document.createElement("a");
        a.href = entry.url;
        a.className = "search-box__result";
        const title = document.createElement("span");
        title.className = "search-box__result-title serif";
        title.textContent = entry.title;
        const meta = document.createElement("span");
        meta.className = "search-box__result-meta mono";
        meta.textContent = `${new Date(entry.date).toLocaleDateString("es-MX", {
          year: "numeric",
          month: "long",
          day: "numeric",
          timeZone: "UTC",
        })} · ${entry.readingTime} min`;
        const desc = document.createElement("p");
        desc.className = "search-box__result-desc";
        desc.textContent = entry.description;
        a.append(title, meta, desc);
        li.append(a);
        results.append(li);
      }
    }

    function syncClear() {
      if (input && clear) clear.hidden = input.value.length === 0;
    }

    input?.addEventListener("input", () => {
      if (!input) return;
      syncClear();
      const query = input.value;
      const terms = normalizeText(query).split(/\s+/).filter(Boolean);
      if (terms.length === 0) {
        render([], "");
        return;
      }
      const matches = entries.filter((entry) =>
        terms.every((term) => normalizeText(entry.searchText).includes(term)),
      );
      render(matches, query.trim());
    });

    clear?.addEventListener("click", () => {
      if (!input) return;
      input.value = "";
      syncClear();
      render([], "");
      input.focus();
    });

    input?.addEventListener("keydown", (event) => {
      if (!input) return;
      if (event.key === "Escape" && input.value !== "") {
        input.value = "";
        syncClear();
        render([], "");
      }
    });

    syncClear();
  }
</script>

<style>
  .search-box {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 720px;
  }
  .search-box__label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-secondary);
  }
  .search-box__field {
    position: relative;
    display: flex;
    align-items: stretch;
  }
  .search-box__input {
    flex: 1 1 auto;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    font-family: var(--font-sans);
    font-size: 1rem;
    padding: 0.6rem 2.75rem 0.6rem 0.75rem;
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    background-color: var(--bg-surface);
    color: var(--ink-primary);
  }
  .search-box__clear {
    position: absolute;
    top: 50%;
    right: 0.25rem;
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0;
    border: none;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--ink-secondary);
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }
  .search-box__clear[hidden] {
    display: none;
  }
  .search-box__clear:hover {
    color: var(--ink-primary);
  }
  .search-box__clear:focus-visible,
  .search-box__result:focus-visible {
    outline: 2px solid var(--accent-terracotta);
    outline-offset: 2px;
  }
  .search-box__help {
    font-size: 0.875rem;
    color: var(--ink-secondary);
    margin: 0;
  }
  .search-box__status {
    font-size: 0.875rem;
    color: var(--ink-secondary);
    margin: 0;
    min-height: 1.2em;
    overflow-wrap: break-word;
  }
  .search-box__results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .search-box__result {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
    overflow-wrap: break-word;
    padding: 1rem;
    border: var(--border-thin);
    border-radius: var(--radius-md);
    background-color: var(--bg-surface);
    text-decoration: none;
    color: var(--ink-primary);
    transition: border-color 0.2s ease;
  }
  .search-box__result:hover {
    border-color: var(--accent-terracotta);
  }
  .search-box__result-title {
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.2;
    overflow-wrap: break-word;
  }
  .search-box__result-meta {
    font-size: 0.75rem;
    color: var(--ink-secondary);
  }
  .search-box__result-desc {
    font-size: 0.9rem;
    color: var(--ink-secondary);
    margin: 0.25rem 0 0;
    overflow-wrap: break-word;
  }
</style>
