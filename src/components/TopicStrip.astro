---
import { withBase } from "../lib/url";

interface Props {
  tags: { tag: string; slug: string; count: number }[];
  limit?: number;
  heading?: string;
}

const { tags, limit = 6, heading = "Temas" } = Astro.props;
const visible = tags.slice(0, limit);
---

{visible.length > 0 && (
  <section class="topic-strip">
    <h2 class="topic-strip__title serif">{heading}</h2>
    <ul class="topic-strip__list">
      {visible.map((item) => (
        <li>
          <a href={withBase(`/etiquetas/${item.slug}/`)} class="tag-chip">
            {item.tag} <span class="tag-chip__count">{item.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  .topic-strip__title {
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin: 0 0 var(--space-3);
  }
  .topic-strip__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .topic-strip__list li {
    min-width: 0;
    max-width: 100%;
  }
  .topic-strip__list a {
    min-height: 44px;
    max-width: 100%;
  }
</style>
