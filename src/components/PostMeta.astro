---
import { formatDate } from "../lib/posts";

interface Props {
  date: Date;
  readingTime: number;
  author: string;
}

const { date, readingTime, author } = Astro.props;
---

<div class="post-meta mono">
  <time datetime={date.toISOString()}>{formatDate(date)}</time>
  <span aria-hidden="true">|</span>
  <span>{readingTime} min de lectura</span>
  <span aria-hidden="true">|</span>
  <span class="post-meta__author">{author}</span>
</div>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    line-height: 1.5;
    letter-spacing: 0.02em;
    color: var(--ink-secondary);
  }
  .post-meta time,
  .post-meta span {
    min-width: 0;
  }
  .post-meta__author {
    overflow-wrap: break-word;
  }
</style>
